// Prisma schema for Loan Repayment Service
// Database: PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Loan {
  id                String   @id @default(uuid())
  principalPaise    Int
  annualRatePercent Decimal  @db.Decimal(5, 2)
  tenureMonths      Int
  disbursementDate  DateTime @db.Date
  emiPaise          Int
  createdAt         DateTime @default(now())

  installments Installment[]
  payments     Payment[]
}

model Installment {
  id                 String   @id @default(uuid())
  loanId             String
  number             Int
  dueDate            DateTime @db.Date
  principalDuePaise  Int
  interestDuePaise   Int
  principalPaidPaise Int      @default(0)
  interestPaidPaise  Int      @default(0)

  loan        Loan                @relation(fields: [loanId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@unique([loanId, number])
}

model Payment {
  id             String   @id @default(uuid())
  loanId         String
  amountPaise    Int
  paidOn         DateTime @db.Date
  idempotencyKey String
  createdAt      DateTime @default(now())

  loan        Loan                @relation(fields: [loanId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@unique([loanId, idempotencyKey])
}

model PaymentAllocation {
  id            String @id @default(uuid())
  paymentId     String
  installmentId String
  interestPaise Int
  principalPaise Int

  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Restrict)
}
